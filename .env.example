# ── Supabase Postgres (production / Vercel) ──
# Supabase Dashboard → Connect → Transaction pooler (port 6543)
DATABASE_URL=
# If you use the Supabase Vercel Marketplace integration, POSTGRES_URL may be injected automatically.
POSTGRES_URL=

# ── Signed session cookie ──
# Generate: openssl rand -base64 48
SESSION_SECRET=

# ── Login accounts ──
# Admin is required for CMS. Mentor account is optional until multi-team auth is implemented.
ADMIN_EMAIL=
ADMIN_PASSWORD=
MENTOR_EMAIL=
MENTOR_PASSWORD=

# Local development: DATABASE_URL boşsa SQLite kullanılır.
