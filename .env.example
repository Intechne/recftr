# Supabase Postgres transaction pooler connection string (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres

# Supabase API / Storage (server only)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Signed application session
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Bootstrap super admin. CMS'ten additional users can be created afterwards.
ADMIN_EMAIL=admin@recfturkiye.org
ADMIN_PASSWORD=CHANGE_THIS_NOW
