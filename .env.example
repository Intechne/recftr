# Supabase Postgres transaction pooler connection string (port 6543)
# SECURITY: use the dedicated recf_app role created by supabase/least-privilege-role-v3.1.0.sql
DATABASE_URL=postgresql://recf_app.PROJECT_REF:LONG_RANDOM_PASSWORD@REGION.pooler.supabase.com:6543/postgres

# Supabase API / Storage (server only — never NEXT_PUBLIC_)
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Signed application session — minimum 32 chars
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Separate salt for hashed rate-limit/security identifiers
RATE_LIMIT_SALT=generate-with-openssl-rand-hex-32

# Self-hosting only: set to a header overwritten by your trusted reverse proxy.
# Vercel uses its own trusted client-IP header automatically.
# TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

# Bootstrap super admin
ADMIN_EMAIL=admin@recfturkiye.org
ADMIN_PASSWORD=USE_A_LONG_UNIQUE_PASSWORD

# Optional but recommended: Base32 TOTP secret for bootstrap admin.
# Generate/enroll in an Authenticator app, then set this in Vercel.
ADMIN_TOTP_SECRET=

# RECF Manuals public API (server-side only; no API key required)
# Used to keep game-manual version, scoring values and official examples current.
RECF_GAMES_API_BASE=https://games.recf.org
# Cache upstream responses in Next/Vercel. Minimum recommended here: 300–900 seconds.
RECF_GAMES_REVALIDATE_SECONDS=900

# Takım Portalı yayın anahtarı — 1 yapıldığında /portal ve mentor girişi açılır
PORTAL_ENABLED=0

# Administrator notifications and applicant receipts (Resend); enable after sender verification.
# Use a verified sender and one administrator inbox. Preview never sends mail. Never NEXT_PUBLIC_.
RECF_NOTIFICATIONS_ENABLED=0
RESEND_API_KEY=
RECF_NOTIFICATION_FROM=
RECF_NOTIFICATION_TO=
